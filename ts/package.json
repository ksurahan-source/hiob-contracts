{
  "name": "@hiob/contracts",
  "version": "0.1.0",
  "description": "HIOB 행성간 타입 계약 (TypeScript 미러) — 단일 소스는 Python, TypeScript는 Zod 선언문서",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:test": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node --test 'dist/**/*.test.js'",
    "test:coverage": "npm run build:test && c8 --exclude-after-remap --check-coverage --branches 100 --functions 100 --lines 100 --statements 100 --reporter=text --reporter=lcov node --test 'dist/**/*.test.js'",
    "pretest": "npm run build:test"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "c8": "12.0.0",
    "typescript": "^5.3.0"
  }
}
